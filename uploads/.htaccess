# Carpeta de imágenes subidas por los creadores.
# Aquí solo se sirven archivos: nada de ejecutar código, pase lo que pase.

php_flag engine off

<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

# Solo se permiten imágenes; cualquier otra extensión queda bloqueada.
<FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
  Require all granted
</FilesMatch>

<FilesMatch "(?i:\.php|\.phtml|\.php\d|\.phar|\.html?|\.js|\.htaccess)$">
  Require all denied
</FilesMatch>

# Las imágenes no cambian nunca: cada subida recibe un nombre nuevo al azar.
# Que el navegador las guarde un año evita volver a descargarlas en cada
# pregunta, que es lo que de verdad aliviana el servidor y los datos del
# público (19/10/2026).
<IfModule mod_headers.c>
  <FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
